PORT=3000

# Set this when the frontend is hosted on a different origin (for example Netlify).
# CLIENT_ORIGIN=https://your-site.netlify.app

# Optional: Twilio TURN for better connectivity behind strict NATs/firewalls
# Get free trial at https://www.twilio.com/console
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token

# Xirsys TURN (use this instead of Twilio if configured)
# XIRSYS_PATH=https://global.xirsys.net
# XIRSYS_IDENT=your_xirsys_ident
# XIRSYS_SECRET=your_xirsys_secret
# XIRSYS_CHANNEL=your_xirsys_channel
